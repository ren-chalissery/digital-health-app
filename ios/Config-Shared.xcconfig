// Build-time configuration.
//
// Unlike the web, which fetches config.json at start-up, an app binary's environment is fixed the
// moment it is built. These values are not secrets — the web serves all of them publicly in its
// own config.json.
//
// The $() in the URL is required: xcconfig treats // as the start of a comment, and this splits
// the sequence without changing the value.

API_BASE_URL = https:/$()/api.simplicityhelp.com
COGNITO_POOL_ID = ap-southeast-2_91O0ya5nC
COGNITO_CLIENT_ID = 2sihmrojcivd93m8of9q4uk1k6
COGNITO_REGION = ap-southeast-2
